# Copy to .env and fill in. Never commit .env.

# --- General ---
NODE_ENV=development
TZ=Asia/Kolkata
LOG_LEVEL=info
# Tokens and browser profiles are stored here, outside the repo. Default: ~/.job-autopilot
APP_HOME=

# --- Safety ---
# true = no outbound third-party actions (applications, emails). Telegram to yourself still sends.
DRY_RUN=true

# --- Database ---
MONGODB_URI=mongodb://127.0.0.1:27017/job-autopilot

# --- API / dashboard ---
API_PORT=4000
WEB_ORIGIN=http://localhost:5173
# Long random string, e.g. output of: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=
ADMIN_EMAIL=you@example.com
# Set with: npm run set-password
ADMIN_PASSWORD_HASH=

# --- LLM (Anthropic) ---
# Empty key or LLM_MOCK=true -> keyword-based mock scorer (no cost)
ANTHROPIC_API_KEY=
# Only needed if the key is not scoped to a workspace (error mentions "anthropic-workspace-id").
ANTHROPIC_WORKSPACE_ID=
LLM_MOCK=false
LLM_MODEL_FAST=claude-haiku-4-5
LLM_MODEL_SMART=claude-sonnet-5-5
MAX_LLM_CALLS_PER_DAY=300

# --- Matching ---
MIN_SCORE=70
MAX_JOB_AGE_DAYS=21

# --- Sources ---
ADZUNA_APP_ID=
ADZUNA_APP_KEY=
ADZUNA_MAX_PAGES=3

# --- Gmail (job alert emails) ---
# Option A (recommended): IMAP with a Gmail App Password. Needs 2-Step Verification on the
# alerts account. Create at https://myaccount.google.com/apppasswords
GMAIL_IMAP_USER=
GMAIL_IMAP_APP_PASSWORD=
# Option B: Google Cloud OAuth client, type "Desktop app" (then: npm run gmail:auth).
# An OAuth app left in "Testing" stops working after 7 days.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GMAIL_ALERT_LABEL=job-alerts
GMAIL_LOOKBACK_DAYS=3

# --- Cold email (Phase 2b) ---
# The Gmail account emails are sent from (your main job-search address), with its App Password.
# Replies and bounces are read from the same account over IMAP.
SMTP_USER=
SMTP_APP_PASSWORD=

# --- Auto-apply (Phase 3) ---
# false = a visible Chrome window, so you can solve a CAPTCHA when one appears.
ATS_HEADLESS=false
ATS_CAPTCHA_WAIT_SECONDS=180
# Links you paste: how long to wait for you to log in / create an account in the browser window.
ATS_LOGIN_WAIT_SECONDS=600

# --- Telegram ---
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# --- Schedules (cron syntax, in TZ above) ---
INGEST_CRON=0 7,15 * * *
DIGEST_CRON=0 9 * * *
